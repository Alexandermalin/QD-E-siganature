        <implementation>nc.impl.uapbd.qd.esign.SupplierAssignmentTransactionServiceImpl</implementation>
    </component>
    <component remote="true" singleton="true" tx="NONE">
        <interface>nc.itf.uapbd.qd.esign.IMaterialCancelAssignmentService</interface>
        <implementation>nc.impl.uapbd.qd.esign.MaterialCancelAssignmentServiceImpl</implementation>
    </component>
    <component remote="false" singleton="true" tx="CMT">
        <interface>nc.itf.uapbd.qd.esign.IMaterialCancelAssignmentTransactionService</interface>
        <implementation>nc.impl.uapbd.qd.esign.MaterialCancelAssignmentTransactionServiceImpl</implementation>
    </component>
</public></module>
