        <implementation>nc.impl.uapbd.qd.esign.WarehouseStateAdapter</implementation>
    </component>
    <component remote="false" singleton="true" tx="CMT">
        <interface>nc.itf.uapbd.qd.esign.IBankAccountStateAdapter</interface>
        <implementation>nc.impl.uapbd.qd.esign.BankAccountStateAdapter</implementation>
    </component>
    <!-- IBankAccountSaveAdapter：银行账户保存（新增/修改）受控适配器，本地 CMT；修改共享账户前取数据库级统一账户锁。 -->
    <component remote="false" singleton="true" tx="CMT">
        <interface>nc.itf.uapbd.qd.esign.IBankAccountSaveAdapter</interface>
        <implementation>nc.impl.uapbd.qd.esign.BankAccountSaveAdapter</implementation>
    </component>
    <!-- IBankAccountDeleteAdapter：银行账户删除受控适配器，本地 CMT；与保存、启停共用数据库级统一账户锁。 -->
    <component remote="false" singleton="true" tx="CMT">
        <interface>nc.itf.uapbd.qd.esign.IBankAccountDeleteAdapter</interface>
        <implementation>nc.impl.uapbd.qd.esign.BankAccountDeleteAdapter</implementation>
    </component>
