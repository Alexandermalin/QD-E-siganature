        <interface>nc.itf.uapbd.qd.esign.ISupplierFreezeAdapter</interface>
        <implementation>nc.impl.uapbd.qd.esign.SupplierFreezeAdapter</implementation>
    </component>
    <component remote="false" singleton="true" tx="CMT">
