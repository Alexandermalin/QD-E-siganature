        <implementation>nc.impl.uapbd.qd.esign.WarehouseSaveAdapter</implementation>
    </component>
    <component remote="true" singleton="true" tx="NONE">
        <interface>nc.itf.uapbd.qd.esign.IMaterialPageDeleteService</interface>
        <implementation>nc.impl.uapbd.qd.esign.MaterialPageDeleteServiceImpl</implementation>
    </component>
