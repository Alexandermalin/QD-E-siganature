<?xml version="1.0" encoding="UTF-8"?>
<!-- 附加服务注册：interface 为服务定位契约，implementation 为对应实现；注册存在不代表节点已验证或策略已启用。 -->
<module name="uapbd"><public>
    <!-- IMaterialOperationAdapter：仅本地调用，禁止作为远程用户服务暴露；加入容器管理事务，异常传播时由容器回滚；单例实现不得保存请求级共享状态。 -->
    <component remote="false" singleton="true" tx="CMT">
<interface>nc.itf.uapbd.qd.esign.IMaterialOperationAdapter</interface>
<implementation>nc.impl.uapbd.qd.esign.MaterialOperationAdapter</implementation>
</component>
    <!-- IMaterialMainDeleteAdapter：物料主档删除受控适配器，本地 CMT；图片目录登记随业务事务提交，文件清理由后台任务执行。 -->
    <component remote="false" singleton="true" tx="CMT">
<interface>nc.itf.uapbd.qd.esign.IMaterialMainDeleteAdapter</interface>
<implementation>nc.impl.uapbd.qd.esign.MaterialMainDeleteAdapter</implementation>
</component>
    <!-- IMaterialImageCleanupService：提交后图片清理维护服务，本地调用，不参与业务事务。 -->
    <component remote="false" singleton="true" tx="NONE">
<interface>nc.itf.uapbd.qd.esign.IMaterialImageCleanupService</interface>
<implementation>nc.impl.uapbd.qd.esign.MaterialImageCleanupServiceImpl</implementation>
</component>
    <component remote="false" singleton="true" tx="CMT">
        <interface>nc.itf.uapbd.qd.esign.IMaterialOrgInfoOperationAdapter</interface>
        <implementation>nc.impl.uapbd.qd.esign.MaterialOrgInfoOperationAdapter</implementation>
    </component>
