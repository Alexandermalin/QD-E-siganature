        <implementation>nc.impl.uapbd.qd.esign.PartnerBatchAdapter</implementation>
    </component>
    <component remote="false" singleton="true" tx="CMT">
        <interface>nc.itf.uapbd.qd.esign.IMaterialStateAdapter</interface>
        <implementation>nc.impl.uapbd.qd.esign.MaterialStateAdapter</implementation>
    </component>
    <component remote="false" singleton="true" tx="CMT">
