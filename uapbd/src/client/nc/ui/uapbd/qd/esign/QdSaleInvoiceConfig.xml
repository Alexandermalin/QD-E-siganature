<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <!-- 保留原生销售发票配置：模型、编辑器、校验器、按钮组、刷新与删除动作全部不动 -->
    <import resource="classpath:nc/ui/so/m32/billui/model/saleinvoice_config.xml" />
    <!--
      本覆盖层只替换 5 个 PF 动作 bean；删除（第 240 行，Delete / 1001Z810000000008DPR）本批关闭，
      继续使用原生 nc.ui.so.m32.billui.action.SaleInvoiceDeleteAction，不在此覆盖。
      property 与原生同名 bean 逐项一致：model/editor/filledUpInFlow/actionName/billType/validationService。
    -->
    <!-- 保存：保留 compositevalidateService（含 SaleInvoiceValidationService 非空校验，powerwritevalidservice 原生已注释） -->
    <bean id="saveAction" class="nc.ui.uapbd.qd.esign.QdSaleInvoiceSaveAction">
        <property name="model" ref="ManageAppModel" />
        <property name="editor" ref="billFormEditor" />
        <property name="validationService" ref="compositevalidateService" />
        <property name="actionName" value="WRITE" />
        <property name="billType" value="32" />
    </bean>
    <!-- 提交：保留 filledUpInFlow=true 与原生 powercommitvalidservice；该 bean 同时被「保存并提交」复合动作复用 -->
    <bean id="commitAction" class="nc.ui.uapbd.qd.esign.QdSaleInvoiceCommitAction">
        <property name="model" ref="ManageAppModel" />
        <property name="editor" ref="billFormEditor" />
        <property name="filledUpInFlow" value="true" />
        <property name="actionName" value="SAVE" />
        <property name="billType" value="32" />
        <property name="validationService" ref="powercommitvalidservice" />
    </bean>
    <!-- 收回：保留 filledUpInFlow=true 与原生 poweruncommitvalidservice -->
    <bean id="unCommitAction" class="nc.ui.uapbd.qd.esign.QdSaleInvoiceUnCommitAction">
        <property name="model" ref="ManageAppModel" />
        <property name="editor" ref="billFormEditor" />
        <property name="filledUpInFlow" value="true" />
        <property name="actionName" value="UNSAVE" />
        <property name="billType" value="32" />
        <property name="validationService" ref="poweruncommitvalidservice" />
    </bean>
    <!-- 审批：保留 filledUpInFlow=true 与原生 powerapprovevalidservice；审批窗口「确定」后才产生业务请求 -->
    <bean id="approveAction" class="nc.ui.uapbd.qd.esign.QdSaleInvoiceApproveAction">
        <property name="model" ref="ManageAppModel" />
        <property name="editor" ref="billFormEditor" />
        <property name="filledUpInFlow" value="true" />
        <property name="actionName" value="APPROVE" />
        <property name="billType" value="32" />
        <property name="validationService" ref="powerapprovevalidservice" />
    </bean>
    <!-- 取消审批：保留 filledUpInFlow=true 与原生 powerunapprovevalidservice 及服务端下游/核销/凭证限制 -->
    <bean id="unApproveAction" class="nc.ui.uapbd.qd.esign.QdSaleInvoiceUnApproveAction">
        <property name="model" ref="ManageAppModel" />
        <property name="editor" ref="billFormEditor" />
        <property name="filledUpInFlow" value="true" />
        <property name="actionName" value="UNAPPROVE" />
        <property name="billType" value="32" />
        <property name="validationService" ref="powerunapprovevalidservice" />
    </bean>
</beans>
