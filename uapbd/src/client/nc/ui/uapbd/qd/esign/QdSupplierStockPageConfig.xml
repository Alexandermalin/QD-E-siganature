<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <import resource="classpath:nc/ui/bd/supplier/config/supplier_stock_config.xml" />
    <bean id="qdNativeSupStockService" class="nc.ui.bd.supplier.stock.model.SupStockAppModelService" />
    <bean id="SupStockAppModelService" class="nc.ui.uapbd.qd.esign.QdSupplierOrgInfoModelService"><constructor-arg ref="qdNativeSupStockService" /><constructor-arg value="BD_SUPPLIER_STOCK" /></bean>
    <bean id="SupStockSaveAction" class="nc.ui.uapbd.qd.esign.QdPartnerOrgInfoSaveAction">
        <constructor-arg ref="SupStockAppModelService" /><property name="operationScope" ref="modelDataManager" /><property name="code" value="StSave" />
        <property name="model" ref="supStockAppModel" /><property name="editor" ref="SupStockInfoView" />
    </bean>
</beans>
