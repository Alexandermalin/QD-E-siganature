<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <import resource="classpath:nc/ui/uapbd/qd/esign/QdCustomerClassStateConfig.xml" />
    <bean id="saveaction" class="nc.ui.uapbd.qd.esign.QdArchiveTreeSaveAction">
        <property name="model" ref="model" /><property name="editor" ref="custclasseditor" /><property name="exceptionHandler" ref="exceptionHandler" />
    </bean>
    <bean id="saveaddaction" class="nc.ui.uapbd.qd.esign.QdArchiveTreeSaveAddAction">
        <property name="model" ref="model" /><property name="editor" ref="custclasseditor" /><property name="exceptionHandler" ref="exceptionHandler" /><property name="addAction" ref="addaction" />
    </bean>
</beans>
