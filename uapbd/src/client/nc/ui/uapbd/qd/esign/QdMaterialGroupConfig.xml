<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <import resource="classpath:nc/ui/bd/material/config/Material_Config_Group.xml" />

    <bean id="exinfoloader" class="nc.ui.uapbd.qd.esign.QdMaterialGroupExinfoLoader">
        <property name="current_md_ID" value="10140MAG" />
    </bean>

    <bean id="modelDataManager" class="nc.ui.uapbd.qd.esign.QdMaterialListModelDataManager">
        <property name="paginationModel" ref="paginationModel" />
        <property name="listModel" ref="baseinfoModel" />
        <property name="queryAssignStatusService" ref="assignService" />
        <property name="assignContext" ref="assignContext" />
    </bean>

    <bean id="service" class="nc.ui.uapbd.qd.esign.QdMaterialModelService">
        <property name="model" ref="baseinfoModel" />
        <property name="extendContext" ref="baseExtendContext" />
    </bean>

    <bean id="saveAction" class="nc.ui.uapbd.qd.esign.QdMaterialSaveAction">
        <constructor-arg ref="service" />
        <property name="operationScope" ref="modelDataManager" />
        <property name="model" ref="baseinfoModel" />
        <property name="editor" ref="baseinfoEditor" />
        <property name="validationService" ref="validationService" />
        <property name="interceptor" ref="compositeActionInterceptor" />
    </bean>

    <import resource="classpath:nc/ui/uapbd/qd/esign/QdMaterialFastAssignConfig.xml" />
</beans>
