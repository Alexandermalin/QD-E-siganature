<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <import resource="classpath:nc/ui/pu/m20/config/praybill_config.xml" />

    <bean id="saveAction" class="nc.ui.pu.qd.esign.QdPraybillSaveAction">
        <property name="model" ref="manageAppModel" />
        <property name="editor" ref="billFormEditor" />
        <property name="actionName" value="SAVEBASE" />
        <property name="billType" value="20" />
        <property name="validationService" ref="validateService" />
    </bean>

    <bean id="deleteAction" class="nc.ui.pu.qd.esign.QdPraybillDeleteAction">
        <property name="model" ref="manageAppModel" />
        <property name="editor" ref="billFormEditor" />
        <property name="actionName" value="DISCARD" />
        <property name="billType" value="20" />
        <property name="validationService" ref="powerDeleteservice" />
    </bean>
</beans>
