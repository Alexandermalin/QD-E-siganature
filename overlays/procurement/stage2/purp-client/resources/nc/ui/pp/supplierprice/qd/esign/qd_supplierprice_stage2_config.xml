<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <import resource="classpath:nc/ui/pp/supplierprice/config/supplierprice_config.xml" />
    <bean id="service" class="nc.ui.pp.supplierprice.qd.esign.QdSupplierPriceModelService">
        <property name="voClass" value="nc.vo.pp.supplierprice.entity.SupplierPriceVO" />
        <property name="service" value="nc.itf.pp.supplierprice.ISupplierPriceService" />
        <property name="context" ref="context" />
    </bean>
    <bean id="appmodel" class="nc.ui.pp.supplierprice.qd.esign.QdSupplierPriceModel">
        <property name="service" ref="service" />
        <property name="businessObjectAdapterFactory" ref="boadatorfactory" />
        <property name="context" ref="context" />
    </bean>
    <bean id="saveAction" class="nc.ui.pp.supplierprice.qd.esign.QdSupplierPriceSaveAction">
        <property name="model" ref="appmodel" />
        <property name="editor" ref="editor" />
        <property name="validationService" ref="validationService" />
    </bean>
    <bean id="deleteAction" class="nc.ui.pp.supplierprice.qd.esign.QdSupplierPriceDeleteAction">
        <property name="model" ref="appmodel" />
        <property name="powercheck" value="true" />
        <property name="permissioncode" value="4221" />
    </bean>
</beans>
