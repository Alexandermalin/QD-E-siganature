<?xml version="1.0" encoding="UTF-8"?>
<!-- 附加服务注册：interface 为服务定位契约，implementation 为对应实现；注册存在不代表节点已验证或策略已启用。 -->
<module name="QD_ESIGN_PURCHASE_ADAPTER">
    <public>
        
    <!-- IPurchaseOrderOperationAdapter：仅本地调用，禁止作为远程用户服务暴露；加入容器管理事务，异常传播时由容器回滚；单例实现不得保存请求级共享状态。 -->
    <component singleton="true" remote="false" tx="CMT">
            <interface>nc.itf.pu.qd.esign.IPurchaseOrderOperationAdapter</interface>
            <implementation>nc.impl.pu.qd.esign.PurchaseOrderOperationAdapter</implementation>
        </component>
    </public>
</module>
